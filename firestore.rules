rules_version = '2';

// ===============================================================
// Assumed Data Model (Cisco Automated v2.1 - Intcomex)
// ===============================================================
//
// Architectural Note:
// This application uses a custom SHA-256 salted RBAC authentication flow
// backed by the `users` collection and local failsafe cache rather than
// Firebase Authentication (`request.auth` is null for standard Web/Desktop
// client operations). Rules below remove any 30-day Test Mode timestamp
// expiration, enforce collection-level isolation (9 explicit collections),
// validate payload schemas and field bounds on both create and update,
// and deny all other paths by default.
//
// Collection 1: estimates/{estimateId}
//   - dealId: string
//   - estimateId: string
//   - partnerName: string
//   - clientFinalName: string
//   - originalFileName: string
//   - createdAt: string (ISO 8601)
//   - creator: map (username, fullName, role, email)
//   - financialSummary: map
//   - headerInfo: map
//   - itemsCount: number
//   - items: list
//   - customOverrideMap: map
//   - fastTrackPromoMap: map (optional)
//
//   Subcollection 1.1: estimates/{estimateId}/versions/{versionId}
//     - versionNumber: number
//     - versionTag: string
//     - type: string
//     - marginPct: number
//     - totalAmount: number
//     - netCiscoTotal: number
//     - items: list
//     - createdAt: string (ISO 8601)
//     - creatorUsername: string
//
// Collection 2: dsv_records/{dsvId}
//   - dealId: string
//   - soNumber: string
//   - poNumber: string
//   - partnerId: string
//   - resellerName: string
//   - endCustomerName: string
//   - endCustomerAddress: string
//   - originalFileName: string
//   - createdAt: string (ISO 8601)
//   - creator: map
//   - financialSummary: map
//   - items: list
//   - overrides: map
//
// Collection 3: users/{userId}
//   - username: string (required)
//   - full_name: string
//   - email: string
//   - role: string ('admin' | 'pm' | 'user' | 'viewer')
//   - password_hash: string (SHA-256 salted hash)
//   - is_active: number (1 or 0)
//   - created_at: string (ISO 8601)
//   - last_login: string (optional)
//   - updated_at: string (optional)
//
// Collection 4: shared_sku_rules/{skuId}
//   - sku: string (required)
//   - rule: string ('equipo' | 'intangible' | 'arancel' | OverrideRuleType)
//   - previousType: string (optional)
//   - note: string (optional)
//   - author: map (username, fullName, role)
//   - updatedAt: string (ISO 8601)
//   - createdAt: string (ISO 8601)
//
// Collection 5: partner_custom_params/{paramId}
//   - id: string
//   - scope: string ('partner' | 'global')
//   - partnerName: string
//   - params: map (internacionPct, arancelPct, margenPct) (required)
//   - durationType: string ('permanent' | '15_days' | '30_days' | 'end_of_month')
//   - expiresAt: number or null
//   - createdAt: string (ISO 8601)
//   - updatedAt: string (ISO 8601)
//   - updatedBy: string (optional)
//
// Collection 6: partners_xcl/{partnerId}
//   - resellerName: string (required)
//   - xclCode: string (required)
//   - updatedAt: number (optional)
//
// Collection 7: cisco_bo_sku_catalog/{skuKey}
//   - partNumber: string (required)
//   - basePartNumber: string
//   - sku: string (required)
//   - updatedAt: string (ISO 8601)
//   - updatedBy: string (optional)
//
// Collection 8: bo_order_tracking/{trackingId}
//   - id: string
//   - estimateId: string (required)
//   - estimateVersionTag: string
//   - dealId: string
//   - partnerName: string
//   - endCustomerName: string
//   - clientPoNumber: string (required)
//   - ciscoSoNumber: string (optional)
//   - courier: string ('FedEx' | 'UPS' | 'DHL' | 'Otro')
//   - courierTrackingNumber: string (optional)
//   - courierTrackingUrl: string (optional)
//   - currentStage: string (required)
//   - estimatedShipDate: string (optional)
//   - estimatedArrivalDate: string (optional)
//   - actualDeliveryDate: string (optional)
//   - createdAt: string (ISO 8601)
//   - updatedAt: string (ISO 8601)
//   - lastDailyReviewAt: string (optional)
//   - totalSaleUsd: number (optional)
//   - grossProfitUsd: number (optional)
//   - marginPct: number (optional)
//   - internacionUsd: number (optional)
//   - arancelUsd: number (optional)
//   - itemsCount: number (optional)
//   - bodegaDestino: string (optional)
//   - notes: list (optional)
//
// Collection 9: cisco_fast_track_catalog/{docId}
//   - Fast Track catalog metadata and chunked products for cloud synchronization
//   - Metadata document ('metadata'): totalSkus, lastUpdated, validFrom, validUntil, promotionCode, promotionTitle, fileName, chunksCount
//   - Chunk documents ('chunk_N'): chunkIndex, totalChunks, items (list of products), updatedAt
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'Administrador' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'mauricio.skill@mayor.cl'
      );
    }

    function isDocOwner(docData) {
      return isAuthenticated() && (
        ('creator' in docData && docData.creator is map && (
          docData.creator.username == request.auth.token.username ||
          docData.creator.email == request.auth.token.email
        )) ||
        docData.userId == request.auth.uid
      );
    }

    function isValidPayloadSize(data) {
      return data is map && data.size() > 0 && data.size() < 50;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidEstimate(data) {
      return isValidPayloadSize(data) &&
        ('estimateId' in data || 'dealId' in data || 'items' in data) &&
        (!('estimateId' in data) || (data.estimateId is string && data.estimateId.size() <= 500)) &&
        (!('dealId' in data) || (data.dealId is string && data.dealId.size() <= 500));
    }

    function isValidDsvRecord(data) {
      return isValidPayloadSize(data) &&
        ('soNumber' in data || 'dealId' in data || 'items' in data) &&
        (!('soNumber' in data) || (data.soNumber is string && data.soNumber.size() <= 500)) &&
        (!('dealId' in data) || (data.dealId is string && data.dealId.size() <= 500));
    }

    function isValidUser(data) {
      return isValidPayloadSize(data) &&
        'username' in data &&
        data.username is string &&
        data.username.size() > 0 &&
        data.username.size() <= 200;
    }

    function isValidSharedSkuRule(data) {
      return isValidPayloadSize(data) &&
        'sku' in data &&
        data.sku is string &&
        data.sku.size() > 0 &&
        data.sku.size() <= 500;
    }

    function isValidPartnerCustomParam(data) {
      return isValidPayloadSize(data) &&
        'params' in data &&
        data.params is map;
    }

    function isValidPartnerXcl(data) {
      return isValidPayloadSize(data) &&
        'resellerName' in data &&
        data.resellerName is string &&
        data.resellerName.size() > 0 &&
        data.resellerName.size() <= 500 &&
        'xclCode' in data &&
        data.xclCode is string &&
        data.xclCode.size() > 0 &&
        data.xclCode.size() <= 200;
    }

    function isValidBoSkuCatalog(data) {
      return isValidPayloadSize(data) &&
        'partNumber' in data &&
        data.partNumber is string &&
        data.partNumber.size() > 0 &&
        data.partNumber.size() <= 500 &&
        'sku' in data &&
        data.sku is string &&
        data.sku.size() <= 500;
    }

    function isValidBoOrderTracking(data) {
      return isValidPayloadSize(data) &&
        'estimateId' in data &&
        'clientPoNumber' in data &&
        'currentStage' in data &&
        data.estimateId is string &&
        data.estimateId.size() <= 500 &&
        data.clientPoNumber is string &&
        data.clientPoNumber.size() <= 500 &&
        data.currentStage is string &&
        data.currentStage.size() <= 200;
    }

    function isValidFastTrackCatalog(data) {
      return data is map && isValidPayloadSize(data);
    }

    // ------------------------------------------------------------------------
    // 1. COLECCIÓN ESTIMATES (Cotizaciones CCW)
    // ------------------------------------------------------------------------
    match /estimates/{estimateId} {
      allow read: if true;
      allow create: if isValidEstimate(request.resource.data);
      allow update: if isValidEstimate(request.resource.data) &&
        (isAdmin() || isDocOwner(resource.data) || !isAuthenticated());
      allow delete: if isAdmin() || isDocOwner(resource.data) || !isAuthenticated();

      // Subcolección: versions (Historial y versiones de la cotización)
      match /versions/{versionId} {
        allow read: if true;
        allow create, update: if isValidPayloadSize(request.resource.data) &&
          (isAdmin() || isDocOwner(get(/databases/$(database)/documents/estimates/$(estimateId)).data) || !isAuthenticated());
        allow delete: if isAdmin() || !isAuthenticated();
      }
    }

    // ------------------------------------------------------------------------
    // 2. COLECCIÓN DSV_RECORDS (Órdenes DSV 48 Horas)
    // ------------------------------------------------------------------------
    match /dsv_records/{dsvId} {
      allow read: if true;
      allow create: if isValidDsvRecord(request.resource.data);
      allow update: if isValidDsvRecord(request.resource.data) &&
        (isAdmin() || isDocOwner(resource.data) || !isAuthenticated());
      allow delete: if isAdmin() || isDocOwner(resource.data) || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 3. COLECCIÓN USERS (Gestión de Identidades y RBAC)
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data) &&
        (isAdmin() || !isAuthenticated());
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 4. COLECCIÓN SHARED_SKU_RULES (Reglas de Reclasificación de SKUs)
    // ------------------------------------------------------------------------
    match /shared_sku_rules/{skuId} {
      allow read: if true;
      allow create, update: if isValidSharedSkuRule(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 5. COLECCIÓN PARTNER_CUSTOM_PARAMS (Perfiles de Parámetros Comerciales)
    // ------------------------------------------------------------------------
    match /partner_custom_params/{paramId} {
      allow read: if true;
      allow create, update: if isValidPartnerCustomParam(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 6. COLECCIÓN PARTNERS_XCL (Base Global de Códigos XCL de Partners)
    // ------------------------------------------------------------------------
    match /partners_xcl/{partnerId} {
      allow read: if true;
      allow create, update: if isValidPartnerXcl(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 7. COLECCIÓN CISCO_BO_SKU_CATALOG (Catálogo Part Number <-> SKU Intcomex)
    // ------------------------------------------------------------------------
    match /cisco_bo_sku_catalog/{skuKey} {
      allow read: if true;
      allow create, update: if isValidBoSkuCatalog(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 8. COLECCIÓN BO_ORDER_TRACKING (Seguimiento Logístico de Back Orders)
    // ------------------------------------------------------------------------
    match /bo_order_tracking/{trackingId} {
      allow read: if true;
      allow create, update: if isValidBoOrderTracking(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // 9. COLECCIÓN CISCO_FAST_TRACK_CATALOG (Catálogo Fast Track y Metadatos)
    // ------------------------------------------------------------------------
    match /cisco_fast_track_catalog/{docId} {
      allow read: if true;
      allow create, update: if isValidFastTrackCatalog(request.resource.data);
      allow delete: if isAdmin() || !isAuthenticated();
    }

    // ------------------------------------------------------------------------
    // DEFAULT DENY (Bloqueo explícito de cualquier otra colección o ruta)
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
