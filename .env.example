# ============================================================================
# CISCO AUTOMATED - VARIABLES DE ENTORNO (.env.example)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Cisco Developer API Suite (OAuth2 Client Credentials M2M - 7 APIs Activas)
# ----------------------------------------------------------------------------
# ⚠️ NOTA DE SEGURIDAD CRÍTICA:
# - En entornos de nube (Cloudflare Pages), configurar los secretos como variables de entorno
#   de servidor o Secrets de Wrangler:
#     npx wrangler secret put CISCO_CLIENT_SECRET
# - NO colocar credenciales confidenciales en variables con prefijo `VITE_` en producción,
#   ya que Vite inyecta dichas variables en texto plano dentro del bundle JavaScript público.

CISCO_CLIENT_ID=your_cisco_client_id_here
CISCO_CLIENT_SECRET=your_cisco_client_secret_here
CISCO_AUTH_URL=https://id.cisco.com/oauth2/default/v1/token

# Fallback de desarrollo local (opcional):
VITE_CISCO_CLIENT_ID=
VITE_CISCO_CLIENT_SECRET=
VITE_CISCO_AUTH_URL=https://id.cisco.com/oauth2/default/v1/token

# ----------------------------------------------------------------------------
# 2. Firebase Cloud Firestore (Configuración de Proyecto)
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
